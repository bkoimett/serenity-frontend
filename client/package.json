{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "reactSnap": {
    "source": "dist",
    "include": [
      "/",
      "/about",
      "/services",
      "/contact",
      "/blog",
      "/gallery"
    ],
    "puppeteerArgs": [
      "--ash-no-nudges",
      "--disable-domain-reliability",
      "--disable-print-preview",
      "--disk-cache-size=33554432",
      "--no-default-browser-check",
      "--no-pings",
      "--single-process",
      "--font-render-hinting=none",
      "--disable-features=AudioServiceOutOfProcess,IsolateOrigins,site-per-process",
      "--enable-features=SharedArrayBuffer",
      "--ignore-gpu-blocklist",
      "--in-process-gpu",
      "--use-gl=angle",
      "--use-angle=swiftshader",
      "--enable-unsafe-swiftshader",
      "--allow-running-insecure-content",
      "--disable-setuid-sandbox",
      "--disable-site-isolation-trials",
      "--disable-web-security",
      "--headless='shell'",
      "--no-sandbox",
      "--no-zygote"
    ],
    "puppeteerExecutablePath": "/tmp/chromium"
  },
  "scripts": {
    "start": "run dev",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "build": "node src/utils/prepareChromium.cjs && vite build && react-snap && node src/utils/generateSitemap.js",
    "generate-sitemap": "node src/utils/generateSitemap.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindplus/elements": "^1.0.18",
    "axios": "^1.13.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.552.0",
    "puppeteer-core": "^25.3.0",
    "quill": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^10.0.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.9.5",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "express": "^5.2.1",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "puppeteer": "^25.3.0",
    "react-snap": "^1.23.0",
    "sitemap": "^9.0.0",
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.7"
  }
}